{
  "name": "migrationguard-mcp",
  "version": "0.1.0",
  "description": "MCP server that reviews Postgres migrations for risky operations. Read-only, no network, no database connection.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firas-mcp-server/migrationguard.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/firas-mcp-server/migrationguard#readme",
  "bugs": "https://github.com/firas-mcp-server/migrationguard/issues",
  "keywords": [
    "postgres",
    "migrations",
    "mcp",
    "prisma",
    "sql",
    "database"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "migrationguard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"node dist/index.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "migrationguard-core": "workspace:*",
    "zod": "4.6.5"
  }
}
