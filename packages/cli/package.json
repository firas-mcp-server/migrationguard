{
  "name": "migrationguard",
  "version": "0.1.0",
  "description": "CLI that reviews Postgres migrations for risky operations and proposes safer alternatives.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firas-mcp-server/migrationguard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/firas-mcp-server/migrationguard#readme",
  "bugs": "https://github.com/firas-mcp-server/migrationguard/issues",
  "keywords": [
    "postgres",
    "migrations",
    "mcp",
    "prisma",
    "sql",
    "database"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "migrationguard": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "dependencies": {
    "migrationguard-core": "workspace:*"
  }
}
